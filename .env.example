# Local development only. npm run setup:local generates .env.local safely.
SILENTECHO_LOCAL_MODE=1
TURSO_DATABASE_URL=file:.local/silentecho.db
SILENTECHO_LOCAL_DATA_DIR=.local
DATA_KEY=

# For Vercel, omit the LOCAL settings above and use a shared remote database:
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
# BLOB_READ_WRITE_TOKEN=
# DATA_KEY=<base64-encoded random 32-byte key; keep stable>
